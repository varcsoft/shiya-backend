model order {
  id            String         @id @db.Uuid
  invoiceNumber Int?           @unique @default(autoincrement())
  userId        String?        @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addressId     String?        @db.Uuid
  transactionId String?        @unique @db.Uuid
  orderStatus   OrderStatus    @default(PLACED)
  orderType     OrderType      @default(TEST)
  address       Address?       @relation(fields: [addressId], references: [id], onDelete: Cascade)
  transaction   transaction?   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productorders productorder[]
  shipment      Shipment?
}

model productorder {
  id                    String           @id @db.Uuid
  categoryId            String?          @db.Uuid
  orderId               String?          @db.Uuid
  productId             String?          @db.Uuid
  product_name          String?
  product_description   String?
  product_price         Decimal?
  offer_price           Decimal?
  product_quantity_type QuantityType?
  variant_label         String?
  variant_quantity      Int?
  variant_quantity_type QuantityType?
  variant_price         Decimal?
  custom                Json?
  productVariantId      String?          @db.Uuid
  quantity              Int
  totalPrice            Int
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  images                images[]
  category              category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order                 order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant        product_variant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
}

enum OrderPaymentStatus {
  UNPAID
  PAID
}

enum OrderStatus {
  PLACED
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderType {
  TEST
  LIVE
}

model Shipment {
  id String @id @default(uuid()) @db.Uuid

  orderId String @unique @db.Uuid
  order   order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  waybill String? @unique

  height Decimal?
  width  Decimal?
  length Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
