generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model role {
  id          String   @id @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id            String         @id @db.Uuid
  email         String         @unique
  password      String?
  firstName     String
  lastName      String?
  gender        String?
  countryCode   String?
  phone         String?
  firebaseUid   String?        @unique
  isVerified    Boolean        @default(false)
  isActive      Boolean        @default(true)
  roleId        String?        @db.Uuid
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  role          role?          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  verifications Verification[]
  carts         cart[]
  order         order[]
  sessions      session[]
  transactions  transaction[]
  wishlists     wishlist[]
}

model Verification {
  id             String  @id @db.Uuid
  userId         String  @db.Uuid
  phoneVerified  Boolean @default(false)
  verificationId String?
  emailVerified  Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id])
}

model collection {
  id                  String               @id @db.Uuid
  name                String
  key                 String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sortOrder           Int?                 @default(0)
  collection_products collection_product[]
  bannerImages        images[]
}

model wishlist {
  id               String           @id @db.Uuid
  userId           String           @db.Uuid
  productId        String           @db.Uuid
  productVariantId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  product          product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   product_variant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, productVariantId])
}

model collection_product {
  id           String     @id @db.Uuid
  collectionId String     @db.Uuid
  productId    String     @db.Uuid
  collection   collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model cart {
  id               String           @id @db.Uuid
  userId           String           @db.Uuid
  productId        String           @db.Uuid
  productVariantId String?          @db.Uuid
  custom           Json?
  quantity         Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  product          product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   product_variant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id           String      @id @db.Uuid
  userId       String      @db.Uuid
  addressline1 String?
  addressline2 String?
  city         String?
  state        String?
  country      String?
  pinCode      String?
  addressType  AddressType @default(HOME)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       order[]
}

model specification {
  id                   String              @id @db.Uuid
  productId            String?             @db.Uuid
  variantId            String?             @db.Uuid
  label                String
  value                String
  sort                 Int?
  superspecificationId String?             @db.Uuid
  deleted              Boolean             @default(false)
  product              product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  superspecification   superspecification? @relation(fields: [superspecificationId], references: [id])
  variant              product_variant?    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
  @@unique([variantId, label])
}

model superspecification {
  id             String          @id @db.Uuid
  label          String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deleted        Boolean         @default(false)
  specifications specification[]
}

model product {
  id                 String               @id @db.Uuid
  name               String
  description        String?
  price              Decimal
  offerPrice         Decimal?
  stock              Int
  details            String[]
  quantityType       QuantityType?
  enableOffer        Boolean              @default(false)
  rating             Decimal?
  deleted            Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  categoryId         String?              @db.Uuid
  subcategoryId      String?              @db.Uuid
  carts              cart[]
  collectionProducts collection_product[]
  images             images[]
  linkedProducts     linked_product[]
  links              links[]
  category           category?            @relation(fields: [categoryId], references: [id])
  subcategory        subcategory?         @relation(fields: [subcategoryId], references: [id])
  productVariants    product_variant[]
  productorders      productorder[]
  specifications     specification[]
  wishlists          wishlist[]
}

model links {
  id        String   @id @db.Uuid
  productId String   @db.Uuid
  label     String
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model linked_product {
  id        String   @id @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model images {
  id               String           @id @db.Uuid
  productId        String?          @db.Uuid
  productVariantId String?          @db.Uuid
  categoryId       String?          @db.Uuid
  subcategoryId    String?          @db.Uuid
  url              String
  blurHash         String?
  productorderId   String?          @db.Uuid
  collectionId     String?          @db.Uuid
  category         category?        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  collection       collection?      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product          product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant   product_variant? @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  productorder     productorder?    @relation(fields: [productorderId], references: [id], onDelete: Cascade)
  subcategory      subcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([url, collectionId])
  @@unique([url, productId])
  @@unique([url, productVariantId])
  @@unique([url, categoryId])
  @@unique([url, subcategoryId])
  @@unique([url, productorderId])
}

model product_variant {
  id             String          @id @db.Uuid
  productId      String?         @db.Uuid
  deleted        Boolean         @default(false)
  label          String?
  sortOrder      Int?            @default(0)
  quantityType   QuantityType?
  rating         Decimal?
  price          Decimal
  offerPrice     Decimal?
  enableOffer    Boolean         @default(false)
  stock          Int
  carts          cart[]
  images         images[]
  product        product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  productorders  productorder[]
  specifications specification[]
  wishlists      wishlist[]

  @@index([productId, sortOrder])
}

model category {
  id            String         @id @db.Uuid
  name          String         @unique
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  images        images[]
  products      product[]
  productorders productorder[]
  subcategories subcategory[]
}

model subcategory {
  id          String    @id @db.Uuid
  name        String
  description String?
  categoryId  String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  images      images[]
  products    product[]
  category    category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model notices {
  id        String   @id @db.Uuid
  content   String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model faqs {
  id        String   @id @db.Uuid
  question  String
  answer    String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model session {
  id              String      @id @db.Uuid
  user_id         String      @db.Uuid
  token           String?
  sessionType     sessionType @default(ACCESS)
  ipaddress       String
  useragent       String?
  devicetype      String?
  operatingsystem String?
  browser         String?
  timestamp       DateTime    @default(now())
  user            User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum QuantityType {
  UNIT
  KILOGRAM
  GRAM
  MILLILITER
  LITER
}

enum sessionType {
  ACCESS
  PASSWORD_RESET
}
